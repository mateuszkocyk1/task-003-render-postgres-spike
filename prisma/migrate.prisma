datasource db {
  provider = "postgresql"
}

model FixtureProbe {
  id        Int                                      @id @default(autoincrement())
  label     String                                   @unique
  counter   Int                                      @default(0)
  version   Int                                      @default(0)
  location  Unsupported("geography(Point, 4326)")?
  createdAt DateTime                                 @default(now()) @map("created_at")

  @@map("fixture_probe")
}
